# Hermes secrets. Mode 0600, root only.
#
# Seeded by the hermes-agent package at /srv/hermes/.env and never overwritten
# on upgrade. Hermes loads this itself; the LuCI page edits it through a
# whitelist so a typo cannot inject arbitrary environment into the agent.
#
# Put API keys here and nowhere else -- specifically not in
# /etc/config/hermes-agent, which is world-readable and included in sysupgrade
# backups.
#
# Uncomment and fill in whichever provider you use:
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# NOUS_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
#
# A custom OpenAI-compatible endpoint (a local llama.cpp / vLLM, say):
# OPENAI_BASE_URL=http://192.168.1.10:8000/v1
