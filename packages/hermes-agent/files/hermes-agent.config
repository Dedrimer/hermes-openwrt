config hermes 'gateway'
	option enabled '0'
	# HERMES_PROFILE to use (empty = upstream default profile)
	option profile 'default'

config hermes 'dashboard'
	option enabled '0'
	option bind '127.0.0.1'
	option port '9119'
	# Bind to non-loopback (0.0.0.0 / LAN IP). As of the June 2026
	# upstream hardening, a public bind always requires an auth provider
	# configured in /etc/hermes/config.yaml or .env.
	option insecure '0'
