# Service control for the Hermes gateway.
#
# This file holds ONLY service-level settings. Hermes' own settings (model,
# provider, toolsets, ...) live in /srv/hermes/config.yaml, and API keys live in
# /srv/hermes/.env with mode 0600 -- never here, because /etc/config is
# world-readable and gets swept into sysupgrade backups.

config service 'serve'
	# Off by default: Hermes needs an API key before it can do anything, so
	# starting it at install time would just produce a crash loop. Enable it
	# from the LuCI page once a provider is configured.
	option enabled '0'

	# Loopback only. The init script refuses anything else -- a public bind
	# would be an unauthenticated agent gateway on your LAN. LuCI reaches the
	# gateway through hermes-chatd, a local bridge, not over the network.
	option host '127.0.0.1'
	option port '9119'

	option log_level 'info'

	# Working directory for agent file operations. Point this at external
	# storage if you care about flash wear.
	option workdir '/srv/hermes/workspace'
