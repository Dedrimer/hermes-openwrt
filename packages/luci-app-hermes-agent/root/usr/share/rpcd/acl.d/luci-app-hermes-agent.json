{
	"luci-app-hermes-agent": {
		"description": "Grant access to Hermes Agent status, control, settings and chat",
		"read": {
			"ubus": {
				"luci.hermes-agent": [ "status", "logs", "settings_get", "chat_poll" ],
				"service": [ "list" ]
			},
			"uci": [ "hermes-agent" ]
		},
		"write": {
			"ubus": {
				"luci.hermes-agent": [ "action", "settings_set", "chat_send" ]
			},
			"uci": [ "hermes-agent" ]
		}
	}
}
