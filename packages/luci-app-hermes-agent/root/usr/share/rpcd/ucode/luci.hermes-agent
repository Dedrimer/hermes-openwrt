//
// rpcd ucode plugin exposing the "hermes-agent" ubus object used by the
// LuCI views. Loaded by rpcd from /usr/share/rpcd/ucode/; the ubus object
// name is taken from the object returned at the end of this file.
//
// Security notes:
//  - all shell invocations go through shellquote() to prevent injection
//  - settings_set only accepts a fixed whitelist of environment keys
//  - config.yaml writes are capped at 64 KiB and keep a .bak copy
//  - ubus ACLs (see acl.d/luci-app-hermes-agent.json) gate every method

'use strict';

import { popen, readfile, writefile, access } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';

const ENV_FILE = '/etc/hermes/.env';
const CONFIG_FILE = '/etc/hermes/config.yaml';

// Environment keys managed through the LuCI settings view. All other
// variables in .env are preserved untouched by settings_set.
const ENV_KEYS = [
	'OPENAI_API_KEY',
	'ANTHROPIC_API_KEY',
	'OPENROUTER_API_KEY',
	'NOUS_API_KEY',
	'GEMINI_API_KEY',
	'HF_TOKEN'
];

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function exec(cmd) {
	let fd = popen(cmd + ' 2>&1');

	if (!fd)
		return { code: -1, output: '' };

	let output = fd.read('all');
	let code = fd.close();

	return { code: code, output: output };
}

function readEnv() {
	let env = {};

	for (let key in ENV_KEYS)
		env[ENV_KEYS[key]] = null;

	let data = readfile(ENV_FILE);

	if (data) {
		for (let line in split(data, '\n')) {
			let m = match(line, /^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/);

			if (m && contains(ENV_KEYS, m[1]))
				env[m[1]] = m[2];
		}
	}

	return env;
}

function writeEnv(env) {
	let kept = [];
	let found = {};
	let data = readfile(ENV_FILE);

	if (data) {
		for (let line in split(data, '\n')) {
			let m = match(line, /^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/);

			if (m && contains(ENV_KEYS, m[1])) {
				found[m[1]] = true;

				if (env[m[1]] != null && env[m[1]] != '')
					kept.push(m[1] + '=' + env[m[1]]);
			}
			else if (line != '') {
				kept.push(line);
			}
		}
	}

	for (let key in ENV_KEYS) {
		let name = ENV_KEYS[key];

		if (!found[name] && env[name] != null && env[name] != '')
			kept.push(name + '=' + env[name]);
	}

	return writefile(ENV_FILE, join(kept, '\n') + '\n');
}

const methods = {
	status: {
		call: function(request) {
			let out = {
				version: readfile('/etc/hermes/.version') || '',
				home: '/etc/hermes',
				disk: null,
				instances: {},
				config: null
			};

			// Disk usage of HERMES_HOME (last line: the matching mount)
			let df = exec('df -k /etc/hermes | tail -n 1');
			let parts = split(trim(df.output), /[ \t]+/);

			if (df.code == 0 && length(parts) >= 5)
				out.disk = {
					size: parts[1],
					used: parts[2],
					avail: parts[3],
					capacity: parts[length(parts) - 2]
				};

			// Runtime state of the hermes-agent service instances
			let ubus = connect();

			if (ubus) {
				let svc = ubus.call('service', 'list', { name: 'hermes-agent', verbose: true });

				if (svc && svc['hermes-agent'])
					out.instances = svc['hermes-agent'].instances || {};
			}

			// UCI configuration
			let c = cursor();

			out.config = {
				gateway: {
					enabled: c.get('hermes-agent', 'gateway', 'enabled') || '0',
					profile: c.get('hermes-agent', 'gateway', 'profile') || 'default'
				},
				dashboard: {
					enabled: c.get('hermes-agent', 'dashboard', 'enabled') || '0',
					bind: c.get('hermes-agent', 'dashboard', 'bind') || '127.0.0.1',
					port: c.get('hermes-agent', 'dashboard', 'port') || '9119',
					insecure: c.get('hermes-agent', 'dashboard', 'insecure') || '0'
				}
			};

			return out;
		}
	},

	action: {
		call: function(request) {
			let op = request.args ? request.args.op : null;

			if (op != 'start' && op != 'stop' && op != 'restart')
				return { code: -1, output: 'Invalid operation: ' + op };

			return exec('/etc/init.d/hermes-agent ' + op);
		}
	},

	logs: {
		call: function(request) {
			let a = request.args || {};
			let lines = 200;
			let pattern = 'hermes';

			if (typeof(a.lines) == 'integer' && a.lines > 0 && a.lines <= 1000)
				lines = a.lines;

			if (typeof(a.pattern) == 'string' && a.pattern != '')
				pattern = a.pattern;

			if (length(pattern) > 200)
				return { code: -1, lines: [] };

			let r = exec('logread -l ' + lines + ' -e ' + shellquote(pattern));

			if (r.code != 0)
				return { code: r.code, lines: [] };

			return { code: 0, lines: filter(split(trim(r.output), '\n'), s => s != '') };
		}
	},

	settings_get: {
		call: function() {
			return {
				env: readEnv(),
				config: readfile(CONFIG_FILE) || ''
			};
		}
	},

	settings_set: {
		call: function(request) {
			let a = request.args || {};

			if (a.config != null) {
				if (typeof(a.config) != 'string' || length(a.config) > 65536)
					return { ok: false, error: 'config must be a string <= 64 KiB' };

				// Keep a backup of the previous configuration
				if (access(CONFIG_FILE))
					exec('cp ' + shellquote(CONFIG_FILE) + ' ' + shellquote(CONFIG_FILE + '.bak'));

				if (!writefile(CONFIG_FILE, a.config))
					return { ok: false, error: 'Failed to write ' + CONFIG_FILE };
			}

			if (a.env != null) {
				if (typeof(a.env) != 'object')
					return { ok: false, error: 'env must be an object' };

				let env = {};

				for (let key in ENV_KEYS) {
					let name = ENV_KEYS[key];
					let value = a.env[name];

					if (value != null && typeof(value) != 'string')
						return { ok: false, error: 'Invalid value for ' + name };

					env[name] = value;
				}

				if (!writeEnv(env))
					return { ok: false, error: 'Failed to write ' + ENV_FILE };
			}

			return { ok: true };
		}
	}
};

return { 'hermes-agent': methods };
